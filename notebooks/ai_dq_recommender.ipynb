import json

def write_rules_to_delta(rules_df, dq_rules_path: str):
    # Convert map parameters to JSON string for portability
    with_json = rules_df.select(
        *[c for c in rules_df.columns if c != "parameters"],
        F.to_json(F.col("parameters")).alias("parameters")
    ).withColumn("created_at", F.current_timestamp())

    (with_json
     .coalesce(1)
     .write
     .format("delta")
     .mode("append")
     .option("mergeSchema", "true")
     .save(dq_rules_path))
    print(f"Rules written to {dq_rules_path}")

